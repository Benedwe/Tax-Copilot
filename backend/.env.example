# Database (Supabase Postgres / PostgreSQL with SSL required)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Recommended direct URL for Prisma migrations when using Supabase pooler:
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"


# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS — set to your deployed frontend origin (comma-separated for multiple)
# Unified Vercel deploy: https://your-project.vercel.app
# Split deploy: https://your-frontend-project.vercel.app
FRONTEND_ORIGIN="http://localhost:3000"

# --- AI / OCR providers (stubbed until you add keys) ---
# Leave blank to run in MOCK mode: the app returns realistic fake
# extraction results so you can build/demo the full flow with no cost.
OPENAI_API_KEY=""
GOOGLE_VISION_API_KEY=""

# File storage
# "local" stores uploads on disk (fine for dev only).
# REQUIRED on Vercel: set STORAGE_DRIVER="supabase" and fill in the Supabase storage vars below.
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

PORT=4000
