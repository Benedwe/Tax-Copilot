# Database (Railway will provide this when you add a PostgreSQL plugin)
DATABASE_URL="postgresql://user:password@localhost:5432/tax_copilot?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS — the deployed frontend origin
FRONTEND_ORIGIN="http://localhost:3000"

# --- AI / OCR providers (stubbed until you add keys) ---
# Leave blank to run in MOCK mode: the app returns realistic fake
# extraction results so you can build/demo the full flow with no cost.
OPENAI_API_KEY=""
GOOGLE_VISION_API_KEY=""

# File storage
# "local" stores uploads on disk (fine for dev / demo).
# Set STORAGE_DRIVER="supabase" and fill in the Supabase storage vars for production.
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

PORT=4000
